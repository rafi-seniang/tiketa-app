# Copy to .env.local to change where the web app looks. These are public addresses, baked in at build time.
# The booking API (this repository). Default: http://localhost:8070
VITE_TIKETA_API_URL=
# The chat agent (github.com/rafi-seniang/tiketa-booking-agent). When it does not answer, the chat shows Off.
# Default: http://localhost:8060
VITE_TIKETA_AGENT_URL=
