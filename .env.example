# Copy to .env. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Comma-separated keys for servers. Empty disables auth (local only).
API_KEYS=
# Signs guest cookies and booking confirmations. Required in production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
GUEST_SESSION_DAYS=7
# The parent domain (for example .example.com) once deployed, so the chat agent's subdomain gets the cookie too.
GUEST_COOKIE_DOMAIN=
CORS_ORIGINS=["http://localhost:5174", "http://localhost:4174"]

# Films, showtimes and bookings (docker compose up -d postgres).
DATABASE_URL=postgresql+psycopg://tiketa:tiketa-local@127.0.0.1:5434/tiketa
# Without Docker: DATABASE_URL=sqlite+aiosqlite:///./tiketa.db

CINEMA_NAME=Tiketa Cinema
CINEMA_TIMEZONE=Asia/Jakarta
MAX_SEATS_PER_BOOKING=8
# How long a prepared booking may wait for its confirmation.
BOOKING_CONFIRMATION_MINUTES=10

# Shared rate limit (docker compose up -d redis). Empty counts per process, local only.
REDIS_URL=redis://127.0.0.1:6384/0
RATE_LIMIT_PER_MINUTE=60
